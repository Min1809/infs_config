<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_auto_close_timesheet" model="ir.cron">
        <field name="name">Auto Close Timesheet (6 PM Weekdays)</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_close_timesheet()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!-- Next run: today at 18:00 UTC; adjust to your server TZ if needed -->
        <field name="nextcall" eval="(datetime.now()).strftime('%Y-%m-%d 11:00:00')"/>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <field name="doall">False</field>
    </record>
</odoo>
