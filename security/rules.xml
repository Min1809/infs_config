<odoo>
    <record id="access_sale_order_viewer" model="ir.model.access">
        <field name="name">INFS_Viewer Sale Order</field>
        <field name="model_id" ref="sale.model_sale_order" />
        <field name="group_id" ref="infs_config.group_viewer_only" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>

    <!-- Record Rule -->
    <record id="rule_sale_order_viewer" model="ir.rule">
        <field name="name">INFS_Viewer Sale Order Rule</field>
        <field name="model_id" ref="sale.model_sale_order" />
        <field name="groups" eval="[(4, ref('infs_config.group_viewer_only'))]" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>


